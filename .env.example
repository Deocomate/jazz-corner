# Sao chép thành .env khi chạy trên máy. KHÔNG commit file .env.
PORT=3000
APP_NAME="Study Hub"
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Mặc định dùng file SQLite: file:data/app.db
# Khi deploy host free (Render) dùng Turso để dữ liệu không mất:
# DATABASE_URL=libsql://ten-db-cua-ban.turso.io
# DATABASE_AUTH_TOKEN=...

# Nghĩa từ cho Word of the Day lấy từ Merriam-Webster (Collegiate Dictionary).
# Lấy khoá miễn phí: đăng ký tại https://dictionaryapi.com/register/index → chọn "Collegiate Dictionary".
# MW_API_KEY=
