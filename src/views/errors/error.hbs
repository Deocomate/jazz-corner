<div class="card card-body mx-auto max-w-lg py-12 text-center">
  <p class="text-sm font-semibold text-red-700">Error {{status}}</p>
  <h1 class="mt-2 text-2xl font-semibold text-ink">Something went wrong</h1>
  <p class="mt-2 text-muted">{{message}}</p>
  <div class="mt-6 flex justify-center gap-2">
    <a href="/" class="btn-secondary" data-back>Go back</a>
    <a href="/" class="btn-primary">Go to Today</a>
  </div>
  {{#if stack}}<pre class="mt-6 overflow-x-auto rounded-lg bg-slate-900 p-4 text-left text-xs text-slate-100">{{stack}}</pre>{{/if}}
</div>
