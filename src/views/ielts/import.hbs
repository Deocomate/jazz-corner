{{#> page-header title="Nhập đề" eyebrow="IELTS Reading" subtitle="Dán đề dạng JSON (do bạn chuẩn bị, trích từ PDF hoặc do AI tạo). Đề luôn được lưu thành bản nháp để bạn duyệt trước khi dùng."}}
  <a href="/ielts" class="btn-ghost">Huỷ</a>
{{/page-header}}
<form method="post" action="/ielts/tests/import" class="card card-body space-y-4">
  {{> form/csrf}}
  {{#if errors._form}}<div class="alert-error">{{errors._form}}</div>{{/if}}
  {{> form/textarea name="json" label="Nội dung JSON" value=values.json error=errors.json rows=16 required=true}}
  <div class="flex justify-end"><button type="submit" class="btn-primary">Nhập thành bản nháp</button></div>
</form>
{{#if example}}
  <details class="card card-body mt-6">
    <summary class="cursor-pointer font-medium">Xem định dạng mẫu</summary>
    <p class="mt-3 text-sm text-muted">Các trường: <code>title</code>, <code>time_limit_minutes</code>, <code>passages[{title, body}]</code> (đoạn văn cách nhau một dòng trống), <code>groups[{passage, type: mcq|tfng|headings|completion, instructions, options?, word_limit?, questions[{number, prompt, options?, answer, accepted?, explanation?, evidence?}]}]</code>.</p>
    <pre class="mt-3 max-h-96 overflow-auto rounded-lg bg-paper p-4 text-xs">{{example}}…</pre>
  </details>
{{/if}}
