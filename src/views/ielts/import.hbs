{{#> page-header title="Import a test" eyebrow="IELTS Reading" subtitle="Paste a test as JSON (prepared by you, extracted from a PDF or generated by AI). It is always saved as a draft for you to review first."}}
  <a href="/ielts" class="btn-ghost">Cancel</a>
{{/page-header}}
<form method="post" action="/ielts/tests/import" class="card card-body space-y-4">
  {{> form/csrf}}
  {{#if errors._form}}<div class="alert-error">{{errors._form}}</div>{{/if}}
  {{> form/textarea name="json" label="JSON" value=values.json error=errors.json rows=16 required=true}}
  <div class="flex justify-end"><button type="submit" class="btn-primary">Import as draft</button></div>
</form>
{{#if example}}
  <details class="card card-body mt-6">
    <summary class="cursor-pointer font-medium">Show the format</summary>
    <p class="mt-3 text-sm text-muted">Fields: <code>title</code>, <code>time_limit_minutes</code>, <code>passages[{title, body}]</code> (paragraphs separated by a blank line), <code>groups[{passage, type: mcq|tfng|headings|completion, instructions, options?, word_limit?, questions[{number, prompt, options?, answer, accepted?, explanation?, evidence?}]}]</code>.</p>
    <pre class="mt-3 max-h-96 overflow-auto rounded-lg bg-paper p-4 text-xs">{{example}}…</pre>
  </details>
{{/if}}
