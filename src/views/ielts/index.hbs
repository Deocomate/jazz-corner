{{#> page-header title="IELTS" eyebrow="Academic · mục tiêu band 8.0–9.0" subtitle="Kho đề tương tác, tách riêng khỏi tài liệu PDF gốc. Bản đầu hỗ trợ Reading; các kỹ năng khác đang ở giai đoạn sau."}}
  <a href="/ielts/tests/import" class="btn-secondary">Nhập đề (JSON)</a>
  <a href="/ielts/tests/new" class="btn-primary">+ Soạn đề mới</a>
{{/page-header}}

{{#if open.length}}
  <section class="mb-10" aria-labelledby="open-title">
    <h2 id="open-title" class="section-title mb-3">Bài đang làm dở</h2>
    <ul class="grid gap-3 md:grid-cols-2">
      {{#each open}}
        <li class="card card-body flex items-center gap-4">
          <div class="min-w-0 flex-1">
            <p class="truncate font-semibold">{{test_title}}</p>
            <p class="text-sm text-muted">Reading · {{modeLabel}} · đã trả lời {{answeredCount}} câu</p>
          </div>
          <a href="/ielts/attempts/{{id}}" class="btn-primary btn-sm">Tiếp tục làm bài</a>
        </li>
      {{/each}}
    </ul>
  </section>
{{/if}}

<section class="mb-10" aria-labelledby="bank-title">
  <div class="mb-3 flex items-baseline justify-between">
    <h2 id="bank-title" class="section-title">Kho đề Reading</h2>
    <span class="text-xs text-muted">Chọn Luyện (có giải thích ngay) hoặc Làm đề (hẹn giờ)</span>
  </div>
  {{#if published.length}}
    <ul class="grid gap-4 md:grid-cols-2">
      {{#each published}}
        <li class="card card-body flex flex-col gap-3">
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="badge-yellow">Reading</span>
            {{> origin-tag origin=origin}}
            {{#if source_pdf_name}}<span class="chip">Có PDF nguồn</span>{{/if}}
          </div>
          <h3 class="font-serif text-lg leading-snug font-semibold">{{title}}</h3>
          {{#if description}}<p class="text-sm text-muted">{{description}}</p>{{/if}}
          <p class="text-xs text-muted">{{question_count}} câu · {{time_limit_minutes}} phút</p>
          <div class="mt-auto flex flex-wrap gap-2">
            {{#each ../modes}}
              <form method="post" action="/ielts/tests/{{../id}}/start">
                {{> form/csrf}}
                <input type="hidden" name="mode" value="{{value}}">
                <button type="submit" class="{{#if (eq value 'exam')}}btn-primary{{else}}btn-secondary{{/if}} btn-sm" title="{{hint}}">{{label}}</button>
              </form>
            {{/each}}
            <a href="/ielts/tests/{{id}}/review" class="btn-ghost btn-sm">Xem / sửa</a>
          </div>
        </li>
      {{/each}}
    </ul>
  {{else}}
    {{> empty-state title="Chưa có đề đã duyệt" text="Soạn hoặc nhập một đề, rồi duyệt để bắt đầu làm."}}
  {{/if}}
</section>

{{#if drafts.length}}
  <section class="mb-10" aria-labelledby="draft-title">
    <h2 id="draft-title" class="section-title mb-3">Bản nháp chờ duyệt</h2>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Đề</th><th>Câu</th><th>Nguồn</th><th><span class="sr-only">Thao tác</span></th></tr></thead>
        <tbody>
          {{#each drafts}}
            <tr>
              <td class="font-medium">{{title}}</td>
              <td>{{question_count}}</td>
              <td>{{> origin-tag origin=origin}}</td>
              <td class="text-right"><a href="/ielts/tests/{{id}}/edit" class="btn-secondary btn-sm">Soạn tiếp</a> <a href="/ielts/tests/{{id}}/review" class="btn-ghost btn-sm">Duyệt</a></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
{{/if}}

{{#if recent.length}}
  <section class="mb-10" aria-labelledby="recent-title">
    <h2 id="recent-title" class="section-title mb-3">Kết quả gần đây</h2>
    <ul class="divide-y divide-line rounded-2xl border border-line bg-white">
      {{#each recent}}
        <li class="flex flex-wrap items-center gap-3 px-5 py-3">
          <span class="min-w-0 flex-1 truncate">{{test_title}} <span class="text-xs text-muted">· {{modeLabel}} · {{formatDate submitted_at}}</span></span>
          <strong>{{score}}/{{total}}</strong>
          <a href="/ielts/attempts/{{id}}/result" class="btn-ghost btn-sm">Xem lại</a>
        </li>
      {{/each}}
    </ul>
  </section>
{{/if}}

<section aria-labelledby="later-title">
  <h2 id="later-title" class="section-title mb-3">Các kỹ năng khác</h2>
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <li class="card card-body"><p class="font-semibold">Listening</p><p class="mt-1 text-sm text-muted">Audio, câu hỏi theo phần, transcript có mốc thời gian.</p><span class="tag-later mt-3">Giai đoạn sau</span></li>
    <li class="card card-body"><p class="font-semibold">Writing</p><p class="mt-1 text-sm text-muted">Task 1 &amp; 2, đếm từ, hẹn giờ, phản hồi theo tiêu chí.</p><span class="tag-later mt-3">Giai đoạn sau</span></li>
    <li class="card card-body"><p class="font-semibold">Speaking (Part 1–3)</p><p class="mt-1 text-sm text-muted">Ghi âm, transcript, mô phỏng phỏng vấn.</p><span class="tag-later mt-3">Giai đoạn sau</span></li>
    <li class="card card-body"><p class="font-semibold">Thi thử tổng hợp</p><p class="mt-1 text-sm text-muted">Khi đủ bốn kỹ năng.</p><span class="tag-later mt-3">Giai đoạn sau</span></li>
  </ul>
</section>
