{{#> page-header title=(default passage.title "New passage") eyebrow=test.title}}
  <a href="/ielts/tests/{{test.id}}/edit" class="btn-ghost">Cancel</a>
{{/page-header}}
<form method="post" action="/ielts/tests/{{test.id}}/passages{{#if passage}}/{{passage.id}}{{/if}}" class="card card-body max-w-4xl space-y-5">
  {{> form/csrf}}
  <div class="grid gap-4 sm:grid-cols-4">
    <div class="sm:col-span-3">{{> form/field name="title" label="Passage title" value=values.title error=errors.title required=true}}</div>
    {{> form/field name="position" type="number" label="Order" value=values.position error=errors.position}}
  </div>
  {{> form/textarea name="body" label="Passage text" value=values.body error=errors.body rows=18 required=true hint="Separate paragraphs with ONE blank line. Paragraphs are labelled A, B, C… automatically (used for Matching Headings)."}}
  <p class="text-xs text-muted">Audio, transcripts and pictures/diagrams for a passage: later phase (the data structure is ready).</p>
  <div class="flex justify-end"><button type="submit" class="btn-primary">Save passage</button></div>
</form>
