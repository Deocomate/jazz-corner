{{#> page-header title=(concat "Question · " group.typeLabel) eyebrow=test.title}}
  <a href="/ielts/tests/{{test.id}}/edit#group-{{group.id}}" class="btn-ghost">Cancel</a>
{{/page-header}}
<div class="mb-4 max-w-3xl rounded-xl bg-paper p-4 text-sm">
  <p class="italic">{{group.instructions}}</p>
  {{#if group.options.length}}<ul class="mt-2">{{#each group.options}}<li><strong>{{key}}</strong>. {{text}}</li>{{/each}}</ul>{{/if}}
</div>
<form method="post" action="/ielts/tests/{{test.id}}/groups/{{group.id}}/questions{{#if question}}/{{question.id}}{{/if}}" class="card card-body max-w-3xl space-y-5">
  {{> form/csrf}}
  <div class="grid gap-4 sm:grid-cols-4">
    {{> form/field name="number" type="number" label="Number" value=values.number error=errors.number required=true}}
    <div class="sm:col-span-3">
      {{#if (eq group.type "headings")}}
        {{> form/field name="prompt" label="Paragraph" value=values.prompt error=errors.prompt required=true placeholder="E.g. Paragraph B"}}
      {{else}}
        {{> form/textarea name="prompt" label="Question / statement" value=values.prompt error=errors.prompt rows=2 required=true}}
      {{/if}}
    </div>
  </div>

  {{#if (eq group.type "mcq")}}
    {{> form/textarea name="options_text" label="Options" value=values.options_text error=errors.options_text rows=5 hint="One option per line: A. … / B. … / C. … / D. …"}}
    {{> form/field name="answer" label="Correct answer (letter)" value=values.answer error=errors.answer required=true placeholder="E.g. C"}}
  {{/if}}
  {{#if (eq group.type "tfng")}}
    {{> form/select name="answer" label="Correct answer" options=tfngOptions value=values.answer error=errors.answer required=true placeholder="— Choose —"}}
  {{/if}}
  {{#if (eq group.type "headings")}}
    <div class="field">
      <label for="f-answer" class="label">Correct heading <span class="text-red-600" aria-hidden="true">*</span></label>
      <select id="f-answer" name="answer" class="input" required>
        <option value="">— Choose —</option>
        {{#each group.options}}<option value="{{key}}" {{selected key ../values.answer}}>{{key}}. {{text}}</option>{{/each}}
      </select>
      {{#if errors.answer}}<p class="field-error">{{errors.answer}}</p>{{/if}}
    </div>
  {{/if}}
  {{#if (eq group.type "completion")}}
    {{> form/field name="answer" label="Model answer" value=values.answer error=errors.answer required=true hint=(concat "Group word limit: " (default group.word_limit "none") ". Case and extra spaces are ignored when marking.")}}
    {{> form/textarea name="accepted_text" label="Other accepted answers" value=values.accepted_text error=errors.accepted_text rows=3 hint="One per line (e.g. British/American spelling, with or without a hyphen)."}}
  {{/if}}

  {{> form/textarea name="evidence" label="Evidence in the passage (exact quote)" value=values.evidence error=errors.evidence rows=2}}
  {{> form/textarea name="explanation" label="Explanation — how the question paraphrases the passage" value=values.explanation error=errors.explanation rows=3}}
  <div class="flex flex-wrap justify-end gap-2">
    {{#unless question}}<button type="submit" name="next" value="add" class="btn-secondary">Save &amp; add another</button>{{/unless}}
    <button type="submit" class="btn-primary">Save question</button>
  </div>
</form>
