{{#> page-header title="Results" eyebrow=attempt.test_title subtitle=(concat "Reading · " attempt.modeLabel " · submitted " (formatDate attempt.submitted_at))}}
  <a href="/ielts" class="btn-ghost">← IELTS</a>
  <a href="/ielts/tests/{{attempt.test_id}}/review" class="btn-secondary">Take this test again</a>
{{/page-header}}

<section class="mb-8 grid gap-4 sm:grid-cols-3">
  <div class="card card-body"><p class="text-sm text-muted">Correct answers</p><p class="mt-1 font-serif text-4xl font-semibold">{{attempt.score}}<span class="text-xl text-muted">/{{attempt.total}}</span></p></div>
  <div class="card card-body"><p class="text-sm text-muted">Accuracy</p><p class="mt-1 font-serif text-4xl font-semibold">{{attempt.percent}}%</p></div>
  <div class="card card-body">
    <p class="text-sm text-muted">Estimated band</p>
    {{#if attempt.band}}<p class="mt-1 font-serif text-4xl font-semibold">{{attempt.band}}</p>
    {{else}}<p class="mt-2 text-sm text-muted">A band is only estimated for a full 40-question test.</p>{{/if}}
  </div>
</section>

<nav class="mb-6 flex flex-wrap gap-1" aria-label="Jump to a question">
  {{#each results}}<a href="#q-{{questionId}}" class="q-pill {{#if isCorrect}}is-correct{{else}}is-wrong{{/if}}" aria-label="Question {{number}} {{#if isCorrect}}correct{{else}}wrong{{/if}}">{{number}}</a>{{/each}}
</nav>

<div class="grid gap-8 lg:grid-cols-5">
  <section class="space-y-4 lg:col-span-3" aria-label="Question by question">
    {{#each results}}
      <article id="q-{{questionId}}" class="card card-body scroll-mt-24 {{#unless isCorrect}}border-red-200{{/unless}}">
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-semibold">Question {{number}}</span>
          <span class="chip">{{typeLabel}}</span>
          {{#if isCorrect}}<span class="badge-green">Correct</span>{{else}}<span class="badge-red">Wrong{{#if note}} · {{note}}{{/if}}</span>{{/if}}
        </div>
        <p class="mt-2" lang="en">{{prompt}}</p>
        <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
          <div><dt class="text-muted">My answer</dt><dd class="font-medium {{#unless isCorrect}}text-red-700{{/unless}}">{{default myDisplay "(blank)"}}</dd></div>
          <div><dt class="text-muted">Correct answer</dt><dd class="font-medium text-emerald-800">{{correctDisplay}}</dd></div>
        </dl>
        {{#if evidence}}<div class="mt-3"><p class="eyebrow mb-1">Evidence in the passage</p><p class="rounded-lg bg-paper p-3 font-serif italic" lang="en">“{{evidence}}”</p></div>{{/if}}
        {{#if explanation}}<div class="mt-3"><p class="eyebrow mb-1">How the question paraphrases the passage</p><p class="text-sm">{{explanation}}</p></div>{{/if}}
        {{#unless isCorrect}}
          {{#if saved}}
            <p class="mt-4 text-sm font-medium text-emerald-800">✓ Saved to Notebook · <a href="/notebook?kind=ielts_mistake">See IELTS mistakes</a></p>
          {{else}}
            <form method="post" action="/ielts/attempts/{{../attempt.id}}/mistakes/{{questionId}}" class="mt-4 space-y-2 border-t border-line pt-4">
              {{> form/csrf}}
              <label for="reason-{{questionId}}" class="label">Why did you get it wrong? (optional)</label>
              <input id="reason-{{questionId}}" name="reason" class="input" placeholder="E.g. misread the scope of the statement / missed the paraphrase">
              <button type="submit" class="btn-secondary btn-sm">Save this mistake to Notebook</button>
            </form>
          {{/if}}
        {{/unless}}
      </article>
    {{/each}}
  </section>

  <aside class="lg:col-span-2" aria-label="Passage">
    <div class="lg:sticky lg:top-6 lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto" data-review-passage>
      <p class="mb-2 text-xs text-muted">Select a sentence in the passage to practise speaking or save it to your Notebook.</p>
      {{#each passages}}<div class="card card-body mb-4">{{> ielts/passage passage=this}}</div>{{/each}}
    </div>
  </aside>
</div>

<div class="selection-bar" data-selection-bar role="toolbar" aria-label="Actions for the selected text" hidden data-review data-config="{{json config}}">
  <button type="button" data-sel-action="speak">Practise speaking</button>
  <button type="button" data-sel-action="notebook">Save to Notebook</button>
</div>
{{> notebook/save-dialog}}
