{{!-- Màn hình làm bài: bài đọc và câu hỏi song song (desktop), chuyển tab (mobile). Hành vi: /js/ielts-take.js --}}
<div class="ielts-take" data-take data-config="{{json config}}">
  <div class="sticky top-0 z-30 border-b border-line bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-2">
      <div class="min-w-0 flex-1">
        <p class="truncate font-serif text-base font-semibold">{{test.title}}</p>
        <p class="text-xs text-muted">Reading · {{attempt.modeLabel}} · <span data-save-status>Đã lưu</span></p>
      </div>
      {{#if attempt.deadline_at}}
        <p class="rounded-full bg-brand-50 px-3 py-1 font-mono text-sm font-semibold text-brand-700" role="timer" aria-live="off" data-timer>--:--</p>
      {{else}}
        <p class="text-xs text-muted">Không giới hạn giờ</p>
      {{/if}}
      <button type="button" class="btn-primary btn-sm" data-open-submit>Nộp bài</button>
    </div>
    <nav class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-4 pb-2" aria-label="Chuyển nhanh tới câu hỏi">
      {{#each questions}}
        <a href="#q-{{id}}" class="q-pill" data-pill="{{id}}" aria-label="Câu {{number}}">{{number}}</a>
      {{/each}}
    </nav>
    <div class="flex border-t border-line lg:hidden" role="tablist" aria-label="Vùng hiển thị">
      <button type="button" role="tab" class="flex-1 py-2.5 text-sm font-medium" data-tab="passage" aria-selected="true">Bài đọc</button>
      <button type="button" role="tab" class="flex-1 py-2.5 text-sm font-medium" data-tab="questions" aria-selected="false">Câu hỏi</button>
    </div>
  </div>

  <div class="mx-auto grid max-w-7xl gap-6 px-4 py-6 lg:grid-cols-2">
    <section class="take-pane lg:sticky lg:top-32 lg:max-h-[calc(100vh-9rem)] lg:overflow-y-auto lg:pr-2" data-pane="passage" aria-label="Bài đọc" {{#if (eq attempt.mode "practice")}}data-allow-speak{{/if}}>
      {{#each passages}}<div class="card card-body mb-6">{{> ielts/passage passage=this}}</div>{{/each}}
    </section>
    <section class="take-pane space-y-8" data-pane="questions" aria-label="Câu hỏi">
      {{#each passages}}
        {{#each groups}}
          <div class="space-y-3">
            <div class="rounded-xl bg-paper p-4">
              <p class="eyebrow mb-1">{{typeLabel}}{{#if word_limit}} · tối đa {{word_limit}} từ{{/if}}</p>
              <p class="text-sm italic" lang="en">{{instructions}}</p>
              {{#if (eq type "headings")}}<ul class="mt-2 text-sm" lang="en">{{#each options}}<li><strong>{{key}}</strong>. {{text}}</li>{{/each}}</ul>{{/if}}
            </div>
            {{#each questions}}{{> ielts/question-input q=this group=.. tfng=@root.tfngOptions practice=(eq @root.attempt.mode "practice")}}{{/each}}
          </div>
        {{/each}}
      {{/each}}
    </section>
  </div>
</div>

<dialog class="modal" data-submit-dialog aria-labelledby="submit-title">
  <form method="post" action="/ielts/attempts/{{attempt.id}}/submit" class="space-y-4 p-6" data-submit-form>
    {{> form/csrf}}
    <input type="hidden" name="answers_json" data-answers-json>
    <h2 id="submit-title" class="section-title">Nộp bài?</h2>
    <p data-unanswered-text class="text-sm"></p>
    <p class="text-sm text-muted">Sau khi nộp, bạn không sửa được câu trả lời. Đáp án, giải thích và bằng chứng sẽ hiện ở trang kết quả.</p>
    <div class="flex justify-end gap-2">
      <button type="button" class="btn-ghost" data-dialog-cancel>Làm tiếp</button>
      <button type="submit" class="btn-primary">Nộp bài</button>
    </div>
  </form>
</dialog>

<div class="selection-bar" data-selection-bar role="toolbar" aria-label="Thao tác với đoạn đã chọn" hidden>
  <button type="button" data-sel-action="speak">Luyện nói</button>
  <button type="button" data-sel-action="notebook">Lưu vào Notebook</button>
</div>
{{> notebook/save-dialog}}
