{{#> page-header title=title subtitle="Only the main text is required. You can add explanations and examples later."}}
  <a href="{{#if item}}/notebook/{{item.id}}{{else}}/notebook{{/if}}" class="btn-ghost">Cancel</a>
{{/page-header}}

<form method="post" action="{{#if item}}/notebook/{{item.id}}{{else}}/notebook{{/if}}" class="card card-body max-w-3xl space-y-5">
  {{> form/csrf}}
  {{#if errors._form}}<div class="alert-error">{{errors._form}}</div>{{/if}}
  <div class="grid gap-4 sm:grid-cols-2">
    {{> form/select name="kind" label="Type" options=kindOptions value=values.kind error=errors.kind required=true}}
    <div class="field">
      <label for="f-tags" class="label">Tags</label>
      <input id="f-tags" name="tags" value="{{values.tags}}" class="input" list="tag-suggestions" placeholder="Academic Writing, Speaking">
      <datalist id="tag-suggestions">{{#each suggestedTags}}<option value="{{this}}"></option>{{/each}}</datalist>
      <p class="hint">Separate tags with commas.</p>
    </div>
  </div>
  {{> form/field name="content" label="Main text" value=values.content error=errors.content required=true placeholder="E.g. Much as I sympathise with this view"}}
  {{> form/textarea name="meaning" label="Meaning / function / nuance" value=values.meaning error=errors.meaning rows=2}}
  {{> form/textarea name="excerpt" label="Original sentence or passage" value=values.excerpt error=errors.excerpt rows=3}}
  {{> form/textarea name="example" label="My example / a variation" value=values.example error=errors.example rows=2 hint="E.g. reuse the pattern on a different topic."}}
  {{> form/textarea name="note" label="Notes (tone, formality, context, collocations…)" value=values.note error=errors.note rows=4}}
  {{#unless item}}<label class="flex items-center gap-2 text-sm"><input type="checkbox" name="review" {{checked values.review}} class="accent-brand-600"> Add to review <span class="text-xs text-muted">(words, patterns and idioms are always reviewed; this is for free notes)</span></label>{{/unless}}
  <div class="flex justify-end gap-2">
    <button type="submit" class="btn-primary">{{#if item}}Save changes{{else}}Save to notebook{{/if}}</button>
  </div>
</form>
