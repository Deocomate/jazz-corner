{{!-- The notebook: one page per day, turned like a real book. Behaviour: /js/notebook-pages.js --}}
<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="eyebrow mb-1">My notebook</p>
    <h1 class="page-title">Notebook</h1>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <button type="button" class="btn-secondary" data-open-contents aria-haspopup="dialog">Contents</button>
    <a href="/notebook/review" class="btn-primary">Review{{#if dueCount}} · {{dueCount}} due{{/if}}</a>
  </div>
</div>

<div class="nb-book mx-auto max-w-3xl" data-notebook data-prev="{{#if prev}}/notebook?page={{prev}}{{/if}}" data-next="{{#if next}}/notebook?page={{next}}{{/if}}">
  <article class="nb-page nb-sheet" aria-labelledby="page-title">
    <header class="flex items-baseline justify-between gap-3">
      <h2 id="page-title" class="nb-date">{{formatWeekday page.date}}</h2>
      <span class="nb-meta">{{#if page.isToday}}Today · {{/if}}{{items.length}} {{#if (eq items.length 1)}}entry{{else}}entries{{/if}}</span>
    </header>

    {{#if items.length}}
      <ol>{{#each items}}{{> notebook/entry}}{{/each}}</ol>
    {{else}}
      <p class="text-muted">{{#if page.isToday}}Nothing written today yet.{{else}}This page is empty.{{/if}}</p>
    {{/if}}

    {{#if page.isToday}}
      <form method="post" action="/notebook/quick" class="nb-entry pt-8" aria-labelledby="quick-title">
        {{> form/csrf}}
        <p id="quick-title" class="nb-kind text-brand-700">What did you learn today?</p>
        <label for="quick-text" class="sr-only">New entry</label>
        <textarea id="quick-text" name="text" rows="3" required maxlength="5000"
          class="block w-full resize-y border-0 bg-transparent p-0 font-serif text-[17px] leading-8 text-ink placeholder:text-slate-400 focus:ring-0 focus:outline-none"
          placeholder="The first line becomes the title. E.g. “Much as I sympathise with…” — a way to concede before disagreeing"></textarea>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <label class="nb-meta flex items-center gap-2">Type
            <select name="kind" class="rounded-md border border-line bg-white px-2 py-1 text-sm text-ink">
              {{#each quickKinds}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
          </label>
          <label class="nb-meta flex min-w-40 flex-1 items-center gap-2">Tags
            <input name="tags" list="nb-quick-tags" class="min-w-0 flex-1 rounded-md border border-line bg-white px-2 py-1 text-sm text-ink" placeholder="Academic Writing, Speaking…">
          </label>
          <datalist id="nb-quick-tags"><option value="Academic Writing"></option><option value="Speaking"></option><option value="Literature"></option>{{#each tagOptions}}<option value="{{value}}"></option>{{/each}}</datalist>
          <label class="nb-meta flex items-center gap-2"><input type="checkbox" name="review" class="accent-brand-600"> Add to review</label>
          <button type="submit" class="btn-primary btn-sm ml-auto">Write it down</button>
        </div>
        <p class="nb-meta">Words, patterns and idioms always go into review; free notes only when you tick the box. <a href="/notebook/new">Full form</a></p>
      </form>
    {{else}}
      <p class="nb-meta pt-8"><a href="/notebook">Go to today’s page to write →</a></p>
    {{/if}}

    <footer class="nb-meta pt-8 text-center">— {{page.number}} —</footer>
  </article>

  <nav class="mt-4 flex items-center justify-between gap-3" aria-label="Turn pages">
    {{#if prev}}<a href="/notebook?page={{prev}}" class="btn-secondary" rel="prev">‹ Previous page</a>{{else}}<span class="btn-secondary pointer-events-none opacity-40" aria-hidden="true">‹ Previous page</span>{{/if}}
    <span class="text-sm text-muted">Page {{page.number}} of {{lastPage}} <span class="hidden sm:inline">· use <span class="kbd">←</span> <span class="kbd">→</span></span></span>
    {{#if next}}<a href="/notebook?page={{next}}" class="btn-secondary" rel="next">Next page ›</a>{{else}}<span class="btn-secondary pointer-events-none opacity-40" aria-hidden="true">Next page ›</span>{{/if}}
  </nav>
</div>

<div class="mx-auto mt-8 max-w-3xl">{{> notebook/filters}}</div>

<dialog class="modal" data-contents aria-labelledby="contents-title">
  <div class="p-6">
    <div class="mb-4 flex items-center justify-between">
      <h2 id="contents-title" class="section-title">Contents</h2>
      <button type="button" class="btn-ghost btn-sm" data-dialog-cancel aria-label="Close">✕</button>
    </div>
    <ol class="max-h-[60vh] divide-y divide-line overflow-y-auto">
      {{#each pages}}
        <li><a href="/notebook?page={{number}}" class="flex items-center gap-3 px-2 py-2.5 hover:bg-brand-50 {{#if (eq number ../page.number)}}font-semibold text-brand-700{{/if}}"{{#if (eq number ../page.number)}} aria-current="page"{{/if}}>
          <span class="w-8 text-right text-xs text-muted">{{number}}</span>
          <span class="flex-1">{{formatWeekday date}}{{#if isToday}} · Today{{/if}}</span>
          <span class="text-xs text-muted">{{count}}</span>
        </a></li>
      {{/each}}
    </ol>
  </div>
</dialog>
