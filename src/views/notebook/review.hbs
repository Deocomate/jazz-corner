{{#> page-header title="Review" eyebrow="Notebook" subtitle="Read the prompt, recall it in your head, then flip the card to check."}}
  <a href="/notebook" class="btn-ghost">← Notebook</a>
{{/page-header}}

{{#if item}}
  <p class="mb-3 text-sm text-muted">{{dueCount}} left for today</p>
  <article class="card mx-auto max-w-2xl">
    <div class="card-body space-y-4 text-center">
      <span class="{{item.kindInfo.badge}}">{{item.kindInfo.label}}</span>
      {{#if item.ielts}}
        <p class="eyebrow">{{item.ielts.testTitle}} · {{item.ielts.typeLabel}}</p>
        <p class="font-serif text-xl leading-snug">{{item.ielts.prompt}}</p>
        <p class="text-sm text-muted">You answered <strong>{{default item.ielts.myAnswer "(blank)"}}</strong>. What is the right answer, and why?</p>
      {{else}}
        <p class="font-serif text-3xl leading-tight font-semibold">{{item.content}}</p>
        <p class="text-sm text-muted">What does it mean, what is its nuance, and how is it used? Try a sentence on a different topic.</p>
      {{/if}}
    </div>
    <details class="group border-t border-line">
      <summary class="cursor-pointer list-none px-6 py-4 text-center font-medium text-brand-700 hover:bg-brand-50">Flip the card</summary>
      <div class="space-y-3 px-6 pb-6 text-left">
        {{#if item.ielts}}
          <p>Answer: <strong class="text-emerald-800">{{item.ielts.correctAnswer}}</strong></p>
          {{#if item.ielts.evidence}}<p class="font-serif italic">“{{item.ielts.evidence}}”</p>{{/if}}
          {{#if item.ielts.explanation}}<p class="text-sm">{{item.ielts.explanation}}</p>{{/if}}
          {{#if item.note}}<p class="text-sm text-muted">Your reason: {{item.note}}</p>{{/if}}
        {{else}}
          {{#if item.meaning}}<p>{{item.meaning}}</p>{{/if}}
          {{#if item.excerpt}}<p class="font-serif italic">“{{item.excerpt}}”</p>{{/if}}
          {{#if item.example}}<p class="text-sm">Example: {{item.example}}</p>{{/if}}
          {{#if item.note}}<p class="text-sm text-muted whitespace-pre-line">{{item.note}}</p>{{/if}}
          {{#unless (or item.meaning item.excerpt item.example item.note)}}<p class="text-sm text-muted">No explanation yet. <a href="/notebook/{{item.id}}/edit">Add one now</a>.</p>{{/unless}}
        {{/if}}
        {{#if item.source_url}}<p class="text-xs"><a href="{{item.source_url}}">Open source: {{item.source_label}}</a></p>{{/if}}
      </div>
    </details>
    <div class="grid grid-cols-2 gap-3 border-t border-line p-4">
      <form method="post" action="/notebook/{{item.id}}/review">
        {{> form/csrf}}
        <input type="hidden" name="result" value="again">
        <button type="submit" class="btn-secondary w-full py-3">Again <span class="text-xs text-muted">(tomorrow)</span></button>
      </form>
      <form method="post" action="/notebook/{{item.id}}/review">
        {{> form/csrf}}
        <input type="hidden" name="result" value="remembered">
        <button type="submit" class="btn-primary w-full py-3">Remembered</button>
      </form>
    </div>
  </article>
{{else}}
  {{> empty-state title="Nothing left to review today" text="You are done. New entries from books, IELTS or the Word of the Day will appear here." actionHref="/notebook" actionLabel="Back to the notebook"}}
{{/if}}
