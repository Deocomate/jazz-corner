{{!-- Nút xoá có hỏi xác nhận. Dùng: {{> form/delete-button action=(concat "/tasks/" id "/delete") confirm="Xoá công việc này?"}} --}}
<form method="post" action="{{action}}" class="inline" data-confirm="{{default confirm 'Are you sure you want to delete this?'}}">
  {{> form/csrf}}
  <button type="submit" class="{{default buttonClass 'btn-ghost btn-sm text-red-600 hover:text-red-700'}}">{{default label 'Delete'}}</button>
</form>
