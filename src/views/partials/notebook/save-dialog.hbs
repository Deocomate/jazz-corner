{{!-- Shared "Save to Notebook" dialog (book reader, IELTS). Behaviour: /js/notebook-save.js --}}
<dialog class="modal" data-notebook-dialog aria-labelledby="nb-title">
  <form class="space-y-4 p-6" data-notebook-form>
    <div>
      <h2 id="nb-title" class="section-title">Save to Notebook</h2>
      <p class="mt-1 text-xs text-muted">Only the main text is needed — add explanations and examples later. It goes onto today’s notebook page.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field">
        <label for="nb-kind" class="label">Type</label>
        <select id="nb-kind" name="kind" class="input">
          <option value="word">Word &amp; collocation</option>
          <option value="pattern">Sentence pattern &amp; grammar</option>
          <option value="idiom">Idiom &amp; expression</option>
          <option value="discourse">Discourse move</option>
          <option value="note">Note</option>
        </select>
      </div>
      <div class="field">
        <label for="nb-tags" class="label">Tags</label>
        <input id="nb-tags" name="tags" class="input" list="nb-tag-options" placeholder="Academic Writing, Speaking…">
        <datalist id="nb-tag-options">
          <option value="Academic Writing"></option>
          <option value="Speaking"></option>
          <option value="Literature"></option>
        </datalist>
      </div>
    </div>
    <div class="field">
      <label for="nb-content" class="label">Main text <span class="text-red-600" aria-hidden="true">*</span></label>
      <input id="nb-content" name="content" class="input" required maxlength="500" placeholder="E.g. Much as I sympathise with this view">
      <p class="hint">Trim it down to the word, phrase or structure you want to remember.</p>
    </div>
    <div class="field">
      <label for="nb-excerpt" class="label">Original passage</label>
      <textarea id="nb-excerpt" name="excerpt" class="input font-serif" rows="3"></textarea>
    </div>
    <div class="field">
      <label for="nb-meaning" class="label">Meaning / function (optional)</label>
      <input id="nb-meaning" name="meaning" class="input" placeholder="E.g. concedes a point before disagreeing">
    </div>
    <p class="text-xs text-muted" data-nb-source></p>
    <div class="alert-error" data-nb-error role="alert" hidden></div>
    <div class="flex justify-end gap-2">
      <button type="button" class="btn-ghost" data-dialog-cancel>Cancel</button>
      <button type="submit" class="btn-primary">Save to Notebook</button>
    </div>
  </form>
</dialog>
