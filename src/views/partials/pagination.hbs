{{!-- Usage: {{> pagination pagination}} (object from buildPagination) --}}
{{#if (or hasPrev hasNext)}}
  <nav class="mt-4 flex items-center justify-between text-sm text-muted" aria-label="Pagination">
    <span>Page {{page}} of {{totalPages}} · {{formatNumber total}} items</span>
    <div class="flex gap-2">
      {{#if hasPrev}}<a class="btn-secondary btn-sm" href="{{prevUrl}}">← Previous</a>{{/if}}
      {{#if hasNext}}<a class="btn-secondary btn-sm" href="{{nextUrl}}">Next →</a>{{/if}}
    </div>
  </nav>
{{/if}}
