{{!-- Ngăn bên: mục lục, bookmark, highlight. Dùng <dialog> để có sẵn focus trap và phím Esc. --}}
<dialog class="side-panel" data-panel="toc" aria-labelledby="toc-title">
  <div class="flex items-center justify-between border-b border-line px-5 py-3">
    <h2 id="toc-title" class="section-title">Mục lục</h2>
    <button type="button" class="btn-ghost btn-sm" data-panel-close aria-label="Đóng">✕</button>
  </div>
  <nav class="overflow-y-auto p-3" aria-label="Mục lục sách">
    <ol class="space-y-0.5" data-toc-list></ol>
    <p class="px-2 py-6 text-sm text-muted" data-toc-empty hidden>Tệp này không có mục lục.</p>
  </nav>
</dialog>

<dialog class="side-panel" data-panel="marks" aria-labelledby="marks-title">
  <div class="flex items-center justify-between border-b border-line px-5 py-3">
    <h2 id="marks-title" class="section-title">Đánh dấu</h2>
    <button type="button" class="btn-ghost btn-sm" data-panel-close aria-label="Đóng">✕</button>
  </div>
  <div class="overflow-y-auto p-5">
    <h3 class="eyebrow mb-2">Bookmark</h3>
    <ul class="mb-6 space-y-1" data-bookmark-list></ul>
    <h3 class="eyebrow mb-2">Highlight &amp; ghi chú</h3>
    <ul class="space-y-3" data-highlight-list></ul>
  </div>
</dialog>

<dialog class="modal" data-note-dialog aria-labelledby="note-title">
  <form method="dialog" class="space-y-4 p-6" data-note-form>
    <h2 id="note-title" class="section-title">Ghi chú cho đoạn đã chọn</h2>
    <blockquote class="max-h-32 overflow-y-auto rounded-lg bg-paper p-3 font-serif text-sm italic" data-note-quote></blockquote>
    <div class="field">
      <label for="note-text" class="label">Ghi chú của bạn</label>
      <textarea id="note-text" class="input" rows="4" data-note-text></textarea>
    </div>
    <div class="flex justify-end gap-2">
      <button type="button" class="btn-ghost" data-dialog-cancel>Huỷ</button>
      <button type="submit" class="btn-primary">Lưu ghi chú</button>
    </div>
  </form>
</dialog>
