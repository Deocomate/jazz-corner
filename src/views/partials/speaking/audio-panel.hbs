{{!-- Model audio: US/UK voice, speed, play all. Always says which kind of audio is playing. --}}
<section class="card card-body" aria-labelledby="audio-title">
  <div class="flex flex-wrap items-center gap-3">
    <h2 id="audio-title" class="section-title flex-1 text-base">Model audio</h2>
    <label class="text-sm text-muted" for="accent">Voice</label>
    <select id="accent" class="input w-auto" data-accent>
      <option value="us">American (en-US)</option>
      <option value="uk">British (en-GB)</option>
    </select>
    <label class="text-sm text-muted" for="rate">Speed</label>
    <select id="rate" class="input w-auto" data-rate>
      <option value="0.6">0.6×</option>
      <option value="0.75">0.75×</option>
      <option value="0.9">0.9×</option>
      <option value="1" selected>1×</option>
      <option value="1.15">1.15×</option>
    </select>
  </div>
  <p class="mt-2 text-xs text-muted" data-audio-status role="status" aria-live="polite">Checking available voices…</p>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button type="button" class="btn-primary" data-play-all>▶ Listen{{#unless (eq item.kind "word")}} to all{{/unless}}</button>
    <button type="button" class="btn-ghost" data-stop>■ Stop</button>
    <label class="ml-auto inline-flex items-center gap-2 text-sm text-muted"><input type="checkbox" data-loop class="accent-brand-600"> Loop</label>
  </div>
</section>
