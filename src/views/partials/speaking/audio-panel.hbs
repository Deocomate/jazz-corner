{{!-- Bảng audio mẫu: chọn giọng Anh/Mỹ, tốc độ, nghe toàn bộ. Hiện rõ loại audio đang dùng. --}}
<section class="card card-body" aria-labelledby="audio-title">
  <div class="flex flex-wrap items-center gap-3">
    <h2 id="audio-title" class="section-title flex-1 text-base">Audio mẫu</h2>
    <label class="text-sm text-muted" for="accent">Giọng</label>
    <select id="accent" class="input w-auto" data-accent>
      <option value="us">Mỹ (en-US)</option>
      <option value="uk">Anh (en-GB)</option>
    </select>
    <label class="text-sm text-muted" for="rate">Tốc độ</label>
    <select id="rate" class="input w-auto" data-rate>
      <option value="0.6">0.6×</option>
      <option value="0.75">0.75×</option>
      <option value="0.9">0.9×</option>
      <option value="1" selected>1×</option>
      <option value="1.15">1.15×</option>
    </select>
  </div>
  <p class="mt-2 text-xs text-muted" data-audio-status role="status" aria-live="polite">Đang kiểm tra giọng đọc…</p>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button type="button" class="btn-primary" data-play-all>▶ Nghe {{#if (eq item.kind "word")}}từ{{else}}toàn bộ{{/if}}</button>
    <button type="button" class="btn-ghost" data-stop>■ Dừng</button>
    <label class="ml-auto inline-flex items-center gap-2 text-sm text-muted"><input type="checkbox" data-loop class="accent-brand-600"> Lặp lại</label>
  </div>
</section>
