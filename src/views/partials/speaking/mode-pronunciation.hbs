<section class="card card-body space-y-5" aria-labelledby="pron-title">
  <h2 id="pron-title" class="section-title text-base">Pronunciation</h2>
  {{#if humanAudio.length}}
    <div class="rounded-xl border border-line bg-paper p-4">
      <p class="text-sm font-semibold">Real speaker <span class="chip ml-1">Human recording</span></p>
      <p class="mt-1 text-xs text-muted">American English, from Merriam-Webster. “Listen” also plays this when the accent is American.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {{#each humanAudio}}
          <button type="button" class="btn-secondary btn-sm" data-pronounce="{{../item.text}}" data-audio="{{url}}">🔊 {{#if pos}}{{pos}}{{else}}Listen{{/if}}{{#if pronunciation}} <span class="font-normal tracking-normal whitespace-nowrap normal-case text-muted">&#92;{{pronunciation}}&#92;</span>{{/if}}</button>
        {{/each}}
      </div>
    </div>
  {{/if}}
  {{#each pronunciation}}
    <div data-pron-word>
      {{#if (gt entries.length 1)}}
        <p class="mb-2 text-sm"><strong>{{word}}</strong> is pronounced differently depending on its part of speech.{{#if fromContext}} Suggested from the original sentence: option {{add suggested 1}}.{{else}} Choose the one you need:{{/if}}</p>
      {{/if}}
      <div class="grid gap-3 {{#if (gt entries.length 1)}}sm:grid-cols-2{{/if}}">
        {{#each entries}}
          <div class="rounded-xl border p-4 {{#if (eq @index ../suggested)}}border-brand-500 bg-brand-50/40{{else}}border-line{{/if}}">
            <p class="text-xs font-semibold tracking-wide text-muted uppercase">{{pos}}{{#if (and (gt ../entries.length 1) (eq @index ../suggested) ../fromContext)}} · suggested by the sentence{{/if}}</p>
            <p class="mt-2 font-serif text-3xl">{{#each syllables}}<span class="{{#if (eq @index ../stress)}}font-bold text-brand-700 underline decoration-2 underline-offset-4{{else}}text-ink{{/if}}">{{this}}</span>{{#unless @last}}<span class="text-muted">·</span>{{/unless}}{{/each}}</p>
            <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
              <div><dt class="text-muted">British</dt><dd class="font-mono">{{uk}}</dd></div>
              <div><dt class="text-muted">American</dt><dd class="font-mono">{{us}}</dd></div>
            </dl>
            {{#if note}}<p class="mt-2 text-sm text-muted">{{note}}</p>{{/if}}
          </div>
        {{/each}}
      </div>
    </div>
  {{/each}}
  {{#if missingPronunciation}}
    <div class="alert-info">There is no reliable IPA data for this text yet, so no IPA or stress marks are shown to avoid mistakes. You can still listen, record yourself and write your own notes (stress, tricky sounds) in My notes.</div>
  {{/if}}
  <p class="text-sm">How to practise: <strong>Listen</strong> → <strong>Record</strong> and say it → <strong>Compare</strong> to hear the model and your take back to back.</p>
  <p class="text-sm"><a href="/speaking/minimal-pairs">Train your ear with minimal pairs →</a></p>
</section>
