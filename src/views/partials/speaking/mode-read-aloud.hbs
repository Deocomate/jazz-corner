<section class="card card-body space-y-4" aria-labelledby="ra-title">
  <h2 id="ra-title" class="section-title text-base">Read Aloud</h2>
  <p class="text-sm text-muted">{{#if (gt sentences.length 1)}}Tap a sentence to practise just that one — Listen, Record and Compare will use it. Then read the whole passage: keep the rhythm across sentences, pause by meaning and vary your voice with the content.{{else}}Listen, record yourself, compare and try again.{{/if}}</p>
  <ol class="space-y-2">
    {{#each sentences}}
      <li class="sentence flex items-start gap-2 rounded-xl border border-line p-3" data-sentence="{{@index}}">
        <span class="mt-1 w-5 shrink-0 text-sm font-semibold text-muted">{{add @index 1}}</span>
        {{#if (gt ../sentences.length 1)}}
          <button type="button" class="min-w-0 flex-1 text-left font-serif text-lg leading-relaxed" data-target-sentence="{{@index}}" aria-pressed="false">{{this}}</button>
        {{else}}
          <p class="min-w-0 flex-1 font-serif text-lg leading-relaxed">{{this}}</p>
        {{/if}}
        <button type="button" class="btn-ghost btn-sm shrink-0" data-play-sentence="{{@index}}" aria-label="Listen to sentence {{add @index 1}}">▶</button>
      </li>
    {{/each}}
  </ol>
  {{#if (gt sentences.length 1)}}<button type="button" class="btn-secondary btn-sm" data-target-all>Practise the whole passage</button>{{/if}}
</section>
