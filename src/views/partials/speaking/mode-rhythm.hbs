<section class="card card-body space-y-5" aria-labelledby="rhythm-title">
  <div class="flex flex-wrap items-center gap-2">
    <h2 id="rhythm-title" class="section-title flex-1 text-base">Rhythm and Intonation</h2>
    {{#if item.hasEdits}}<span class="badge-green">Edited by you</span>{{else}}<span class="badge-yellow">Automatic suggestion</span>{{/if}}
  </div>
  <ul class="flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted" aria-label="Legend">
    <li><span class="rw rw-stress">STRESS</span> stressed word</li>
    <li><span class="rw rw-weak">weak</span> usually reduced</li>
    <li><span class="font-semibold text-brand-600">‿</span> linking</li>
    <li><span class="font-semibold text-brand-600">|</span> pause between thought groups · <span class="font-semibold text-brand-600">||</span> end of sentence</li>
  </ul>
  <div class="space-y-4 font-serif text-xl leading-loose" data-rhythm>
    {{#each rhythm}}
      <p>
        {{#each phrases}}
          <span class="phrase" data-seg-index="{{globalIndex}}">{{#each words}}<button type="button" class="rw {{#if stressed}}rw-stress{{else if weak}}rw-weak{{/if}}{{#if edited}} rw-edited{{/if}}" data-word-index="{{index}}" aria-pressed="{{#if stressed}}true{{else}}false{{/if}}">{{text}}</button>{{#if linkNext}}<span class="link-mark" aria-label="linked">‿</span>{{else}} {{/if}}{{/each}}</span>
          <button type="button" class="play-seg" data-play-seg="{{globalIndex}}" aria-label="Play this thought group">▶</button>
          {{#unless @last}}<span class="pause-mark" aria-hidden="true">|</span>{{/unless}}
        {{/each}}
        <span class="pause-mark" aria-hidden="true">||</span>
      </p>
    {{/each}}
  </div>
  <div class="flex justify-end border-t border-line pt-4">
    <button type="button" class="btn-secondary btn-sm" data-save-markup disabled>Save changes</button>
  </div>
</section>

<section class="card card-body" aria-labelledby="contrast-title">
  <h2 id="contrast-title" class="section-title text-base">Sentence stress can change the meaning</h2>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl bg-paper p-4"><p class="font-serif text-lg">I wanted the <strong class="text-brand-700 uppercase">blue</strong> one.</p><p class="mt-1 text-sm text-muted">Contrasting colour: the blue one, not another colour.</p></div>
    <div class="rounded-xl bg-paper p-4"><p class="font-serif text-lg"><strong class="text-brand-700 uppercase">I</strong> wanted the blue one.</p><p class="mt-1 text-sm text-muted">Contrasting people: I wanted it, not someone else.</p></div>
  </div>
  <p class="mt-3 text-xs text-muted">Synthetic voices cannot stress words on purpose — record yourself saying both versions and compare.</p>
</section>
