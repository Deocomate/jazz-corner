{{!-- Bản thu: lần mới nhất mở sẵn (để tự đánh giá ngay), các lần trước thu gọn và lọc được theo chế độ. --}}
<section id="recordings" class="card card-body scroll-mt-24" aria-labelledby="recs-title">
  <h2 id="recs-title" class="section-title text-base">Your latest take</h2>
  {{#if recordings.length}}
    {{#with recordings.[0]}}
      <div id="rec-{{id}}" class="mt-3 scroll-mt-24" data-latest-take>{{> speaking/recording-item}}</div>
    {{/with}}
  {{else}}
    <p class="mt-2 text-sm text-muted">Press <strong>● Record</strong> and say it. Your take appears here so you can compare it with the model straight away.</p>
  {{/if}}
</section>

{{#if (gt recordings.length 1)}}
  <details class="card card-body group" data-history>
    <summary class="flex cursor-pointer list-none items-center gap-2">
      <span class="section-title flex-1 text-base">Earlier takes <span class="text-sm font-normal text-muted">({{add recordings.length -1}})</span></span>
      <span class="text-muted transition-transform group-open:rotate-180" aria-hidden="true">⌄</span>
    </summary>
    <div class="mt-3 flex flex-wrap gap-1.5" role="group" aria-label="Filter by mode" data-history-filter>
      <button type="button" class="chip is-on" data-filter="" aria-pressed="true">All</button>
      {{#each recordingModes}}<button type="button" class="chip" data-filter="{{value}}" aria-pressed="false">{{label}}</button>{{/each}}
    </div>
    <ul class="mt-3 divide-y divide-line">
      {{#each recordings}}{{#unless @first}}
        <li id="rec-{{id}}" class="scroll-mt-24 py-4" data-rec-mode="{{mode}}">{{> speaking/recording-item}}</li>
      {{/unless}}{{/each}}
    </ul>
  </details>
{{/if}}
