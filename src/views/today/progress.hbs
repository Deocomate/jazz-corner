{{#> page-header title="Progress" eyebrow="From what you have saved" subtitle="Every number here comes from your real books, notebook, IELTS attempts and Speaking recordings."}}{{/page-header}}

<section class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Overview">
  <div class="card card-body"><p class="text-sm text-muted">Due for review</p><p class="mt-1 font-serif text-3xl font-semibold">{{dueCount}}</p><a href="/notebook/review" class="text-xs">Review now</a></div>
  <div class="card card-body"><p class="text-sm text-muted">Reviews in the last 7 days</p><p class="mt-1 font-serif text-3xl font-semibold">{{reviewed}}</p></div>
  <div class="card card-body"><p class="text-sm text-muted">Reading tests submitted</p><p class="mt-1 font-serif text-3xl font-semibold">{{submittedCount}}</p></div>
  <div class="card card-body"><p class="text-sm text-muted">Speaking practice days</p><p class="mt-1 font-serif text-3xl font-semibold">{{sessions.days}}</p><p class="text-xs text-muted">{{sessions.total}} recordings</p></div>
</section>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="card card-body" aria-labelledby="pr-books">
    <h2 id="pr-books" class="section-title mb-4">Books in progress</h2>
    {{#if reading.length}}
      <ul class="space-y-3">
        {{#each reading}}
          <li><a href="/books/{{id}}" class="font-medium hover:text-brand-700">{{title}}</a>
            <div class="mt-1 flex items-center gap-2"><div class="progress"><span style="width: {{percent}}%"></span></div><span class="w-10 text-right text-xs text-muted">{{percent}}%</span></div>
            {{#if location_label}}<p class="text-xs text-muted">{{location_label}}</p>{{/if}}
          </li>
        {{/each}}
      </ul>
    {{else}}<p class="text-sm text-muted">No reading data yet. <a href="/books">Open a book</a> to start tracking.</p>{{/if}}
  </section>

  <section class="card card-body" aria-labelledby="pr-ielts">
    <h2 id="pr-ielts" class="section-title mb-4">Recent IELTS Reading</h2>
    {{#if recent.length}}
      <ul class="divide-y divide-line">
        {{#each recent}}
          <li class="flex items-center gap-3 py-2 text-sm"><a href="/ielts/attempts/{{id}}/result" class="min-w-0 flex-1 truncate hover:text-brand-700">{{test_title}}</a><span class="text-muted">{{modeLabel}}</span><strong>{{score}}/{{total}}</strong></li>
        {{/each}}
      </ul>
    {{else}}<p class="text-sm text-muted">No submitted tests yet. <a href="/ielts">Take a Reading test</a>.</p>{{/if}}
  </section>

  <section class="card card-body" aria-labelledby="pr-types">
    <h2 id="pr-types" class="section-title mb-1">Question types you miss most</h2>
    <p class="mb-4 text-xs text-muted">Error rate by question type across submitted tests.</p>
    {{#if hasTypeData}}
      <ul class="space-y-3">
        {{#each types}}
          <li class="text-sm"><div class="flex justify-between"><span>{{label}}</span><span class="text-muted">{{wrong}}/{{total}} wrong · {{rate}}%</span></div><div class="progress mt-1"><span style="width: {{rate}}%"></span></div></li>
        {{/each}}
      </ul>
    {{else}}<p class="text-sm text-muted">Submit at least one test to see this.</p>{{/if}}
  </section>

  <section class="card card-body" aria-labelledby="pr-reasons">
    <h2 id="pr-reasons" class="section-title mb-1">Recurring mistakes</h2>
    <p class="mb-4 text-xs text-muted">From the reasons you wrote when saving wrong answers ({{mistakeCount}} questions).</p>
    {{#if reasons.length}}
      <ul class="space-y-2">{{#each reasons}}<li class="flex items-start gap-3 text-sm"><span class="badge-red shrink-0">{{count}}×</span><span>{{text}}</span></li>{{/each}}</ul>
      <a href="/notebook?kind=ielts_mistake" class="mt-4 inline-block text-sm">See all IELTS mistakes →</a>
    {{else}}<p class="text-sm text-muted">Not enough data yet. When you save a wrong answer, write why (e.g. misread the scope of the statement) to spot patterns.</p>{{/if}}
  </section>

  <section class="card card-body" aria-labelledby="pr-speak">
    <h2 id="pr-speak" class="section-title mb-4">Recent Speaking</h2>
    {{#if recordings.length}}
      <ul class="divide-y divide-line">
        {{#each recordings}}
          <li class="py-2 text-sm"><a href="/speaking/items/{{item_id}}?mode={{mode}}#rec-{{id}}" class="font-medium hover:text-brand-700">{{default item_title item_text}}</a><p class="text-xs text-muted">{{mode}} · {{formatDate created_at}}{{#if note}} · {{note}}{{/if}}</p></li>
        {{/each}}
      </ul>
    {{else}}<p class="text-sm text-muted">No recordings yet. <a href="/speaking">Practise speaking</a> and record yourself to track progress.</p>{{/if}}
  </section>

  <section class="card card-body" aria-labelledby="pr-flag">
    <h2 id="pr-flag" class="section-title mb-4">Words and sentences to revisit (Speaking)</h2>
    {{#if flagged.length}}
      <ul class="divide-y divide-line">
        {{#each flagged}}
          <li class="py-2 text-sm"><a href="/speaking/items/{{item_id}}?mode={{mode}}#rec-{{id}}" class="font-serif hover:text-brand-700">{{default target_text (default item_title item_text)}}</a>{{#if note}}<p class="text-xs text-muted">{{note}}</p>{{/if}}</li>
        {{/each}}
      </ul>
    {{else}}<p class="text-sm text-muted">Tick “Needs work” on a recording and it will show up here.</p>{{/if}}
  </section>
</div>
